{
  "name": "dogeminer-community-edition",
  "version": "0.1.0",
  "description": "A modern, browser-based clicker game rebuilt from scratch using JavaScript and HTML",
  "main": "index.html",
  "scripts": {
    "start": "python -m http.server 8000",
    "serve": "python -m http.server 8000",
    "dev": "python -m http.server 8000",
