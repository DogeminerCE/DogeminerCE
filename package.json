  },
  "bugs": {
    "url": "https://github.com/DogeMinerCE/DogeMinerCE/issues"
  },
  "homepage": "https://github.com/DogeMinerCE/DogeMinerCE#readme",
  "devDependencies": {
    "sharp": "^0.33.2",
    "playwright": "1.56.1"
  },
  "dependencies": {},
  "engines": {
    "node": ">=20"
  }
