  "stories": [
    {
      "id": "tothemoon",
      "title": "TO THE MOON!",
      "body": "You need a <red>SPACE ROCKET</red> to go to <blue>THE MOON</blue>. It costs <orange>50,000</orange> <green>ĐOGECOINS</green>.",
      "image": "story/to_the_moon",
      "type": "info",
      "followups": [
        {
          "kind": "hint",
          "delay": 2500
        },
        {
          "kind": "rocketFlash"
        }
      ]
    },
    {
      "id": "newtimeline",
      "title": "MISSION SUCCESSFUL",
      "body": "Well done! You are back in the present. Your <blue>TIME MACHINE</blue> was stolen on the way back. You are also missing all pickaxes. However, with this super fortune from the future, finding even better gear will be <green>easy-peasy!</green>",
      "image": "story/to_the_moon",
      "type": "info",
      "followups": [
        {
          "kind": "delay",
          "delay": 16000
        },
        {
          "kind": "news",
          "id": "upgfast2k",
          "title": "FASTER!",
          "info": "Your experience is showing",
          "details": "SearchDoges now sniff out upgrades <green>MUCH fast!</green>!"
        }
      ]
    },
    {
      "id": "newtimeline3",
      "title": "WELL WHAT NOW?",
      "body": "History keeps repeating itself! Much confuse. Maybe try something different if you go back again? <i>PS. There are new options for turning off news and story-popups!</i>",
      "image": "story/to_the_moon",
      "type": "info",
      "followups": []
    },
    {
      "id": "newtimeline4",
      "title": "UHH OKAY",
      "body": "Welcome back... again. You know what just happened. You know exactly what you did. On the bright side, you are getting some serious juice into these fortunes!",
      "image": "story/to_the_moon",
      "type": "info",
      "followups": []
    },
    {
      "id": "newtimeline5",
      "title": "YOU KNOW THE DRILL",
      "body": "You know the drill. That is all. May you one day break this paradoxical curse. Godspeed.",
      "image": "story/to_the_moon",
      "type": "info",
      "followups": []
    },
    {
      "id": "bonus",
      "title": "SUCH BONUS",
      "body": "Some objects may increase <green>INCOME</green>. A <orange>BONUSCOIN</orange> temporarily increases <green>INCOME</green> by <green>50%</green> for <dark>60 seconds</dark>.",
      "image": "general/bonuscoin",
      "type": "info",
      "followups": []
    }
  ],
